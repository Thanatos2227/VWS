# ==============================================================================
# Vetri Water Solutions (VWS) — Environment Configuration Template
# Document Reference: DOC-006 (Security Architecture §8)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Populate the variables below with the genuine Firebase Web App credentials
#    issued by the Google Cloud Console / Firebase Console for project 'vetri-water-solutions'.
# 3. DO NOT commit '.env' to Git (enforced via .gitignore).
# ==============================================================================

# Firebase Client SDK Configuration (Required for Web and Android)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=vetri-water-solutions.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vetri-water-solutions
VITE_FIREBASE_STORAGE_BUCKET=vetri-water-solutions.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_web_app_id_here

# Single-Owner Access Control Guard (DOC-006 §2 / DEC-02)
VITE_AUTHORIZED_OWNER_EMAIL=vetriwatersolution@gmail.com
VWS_OWNER_EMAIL=vetriwatersolution@gmail.com

# Google Drive Integration (DEC-15)
VITE_GOOGLE_DRIVE_FOLDER_NAME=Vetri Water Solutions

# Optional: Local Emulator Suite IP for physical device LAN testing
# If testing an Android APK against a workstation running Firebase Emulators on the local Wi-Fi:
# VITE_FIREBASE_EMULATOR_HOST=192.168.1.100

