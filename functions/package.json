{
  "name": "vws-functions",
  "private": true,
  "main": "lib/index.js",
  "description": "Firebase Cloud Functions (2nd Gen) for Vetri Water Solutions",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}