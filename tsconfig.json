{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "firebase-functions/v2/https": ["functions/node_modules/firebase-functions/lib/v2/providers/https.d.ts"],
      "firebase-functions": ["functions/node_modules/firebase-functions/lib/index.d.ts"],
      "firebase-admin/*": ["functions/node_modules/firebase-admin/lib/*"],
      "firebase-admin": ["functions/node_modules/firebase-admin/lib/index.d.ts"]
    }
  },
  "include": ["src", "tests", "scripts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
